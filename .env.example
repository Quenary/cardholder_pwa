# Populate any of these vars if needed and save file as .env in project root folder. Dockerfile will copy it to the image.
# However, it is recommended to use variables in docker-compose.
# For development purposes, you can save file to /backend/.env

# Base path for api.
# If this variable changes, then corresponding changes must be made 
# in frontend's environment.*.ts, as well as nginx.conf
API_PATH=/api

# App log level, mainly for the uvicorn command in start.py
# critical, error, warning, info, debug, trace
LOG_LEVEL=warning

# Default secret is autogenerated so on every container startup the access tokens will become invalid,
# but refresh tokens are stored in db and will remain valid.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_LIFETIME_MIN=5
# 43200 is a month
REFRESH_TOKEN_LIFETIME_MIN=43200
PASSWORD_RECOVERY_CODE_LIFETIME_MIN=15

# Default is sqlite file located in container's "/cardholder_pwa/cardholder_pwa.db",
# mounted to host's "$HOME/.cardholder_pwa" if using provided docker command or docker-compose
# DB_URL=sqlite+aiosqlite:////cardholder_pwa/cardholder_pwa.db
# Supported drivers are:
# "sqlite+aiosqlite:" for sqlite
# "postgresql+asyncpg:" for postgresql
# "mysql+asyncmy:" for mysql or mariadb
DB_URL=
DB_CLEANUP_INTERVAL_MIN=360

# Card logos.
# Directory holding the uploaded logos. It defaults to a folder next to the
# sqlite database, so the same volume/backup covers both.
LOGO_DIR=
# Largest accepted upload, in bytes. Default is 2 MiB.
# The limit is enforced while reading the request, before the image is decoded.
LOGO_MAX_UPLOAD_BYTES=
# Logos larger than this (in pixels) are downscaled. Default is 1024.
# It is also the width SVG uploads are rendered at.
LOGO_MAX_DIMENSION=
# Seconds allowed to rasterise an uploaded SVG. Default is 10.
# Rendering happens in a child process that is killed past this limit: render
# time is unrelated to file size, and a tiny SVG can take minutes.
LOGO_SVG_TIMEOUT_SEC=

# SMTP client configuration.
# It is used to send password recovery emails.
SMTP_DISABLED=FALSE
# SMTP encryption
# The options are:
# - TLS (Implicit TLS, uusually on port 465)
# - STARTTLS (Explicit TLS, usually on port 587)
# - Any other value considered as no encryption with default port of 25
# The old variable SMTP_USE_TLS is deprecated and will be removed,
# for now it stands for STARTTLS value.
SMTP_ENCRYPTION=
# Hostname or IP address of the SMTP server
SMTP_SERVER=
# Port of the SMTP server
# Default is depending on the encryption used
SMTP_PORT=
SMTP_FROM_EMAIL=
# Display name shown in the recipient's inbox next to the address
# (e.g. "Cardholder - Famille Bonnier"). Optional.
SMTP_FROM_NAME=
SMTP_USERNAME=
SMTP_PASSWORD=
# SMTP timeout in seconds
SMTP_TIMEOUT=10